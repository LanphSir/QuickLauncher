{
  "name": "quick-launcher",
  "version": "0.4.10",
  "description": "快捷桌面启动器 — 全局快捷键唤起的插件化工具面板（类 uTools）",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "icons": "node scripts/gen-icons.mjs",
    "build:plugins": "pnpm -r --filter ./plugins/** run build",
    "dev": "pnpm run build:plugins && electron-vite dev",
    "dev:plugin": "node scripts/dev-plugin.mjs",
    "build": "electron-vite build",
    "dist": "pnpm run build:plugins && pnpm run build && node scripts/collect-plugins.mjs && electron-builder --win",
    "smoke": "node scripts/smoke.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.web.json"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "naive-ui": "^2.43.0",
    "pinia": "^3.0.3",
    "vue": "^3.5.0"
  }
}
